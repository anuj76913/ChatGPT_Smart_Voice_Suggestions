# TEMPLATE ONLY: this file is committed to git. Copy it to .env (git-ignored) and put real values there.
# Never put a real key or password in this file. Staging/production use the platform secret store.

# local | test | staging | production
APP_ENV=local
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL. `npm run db:local:init` creates a project-only cluster and fills in both URLs in .env for you.
DATABASE_URL=postgres://svs:CHANGE_ME@127.0.0.1:5433/svs_dev
# Used only by the integration tests (wiped on every test run). Never point this at real data.
TEST_DATABASE_URL=postgres://svs:CHANGE_ME@127.0.0.1:5433/svs_test

# Groq. Separate key per environment (docs/phase0/groq-setup.md). Put the real key in .env, never here.
GROQ_API_KEY=
# For UI work without a key: run `npm run dev:fake-groq` and set this in .env:
# GROQ_BASE_URL=http://127.0.0.1:8790

# Session cookie signing secret (≥32 chars). Required in staging/production; a dev default is used locally.
# SESSION_SECRET=

# Handles allowed to use the admin APIs (runtime config, analytics dashboard at /#/admin/analytics), comma-separated.
ADMIN_USERS=admin

# Web origin(s) allowed to call the API and open the voice WebSocket, comma-separated
# (locally the Vite dev proxy makes requests same-origin; on Railway set your Vercel URL, see docs/DEPLOY.md)
WEB_ORIGIN=http://localhost:5173

# Deployment (docs/DEPLOY.md). Web on Vercel + API on Railway:
# VOICE_WS_TOKEN_ONLY=true    # voice WebSocket goes straight to the API host; its signed token identifies the user
# APPLY_DEMO_CONFIG=true      # turn the team-demo config on once, on a fresh database
# MIGRATE_ON_START=true       # run SQL migrations when the server starts
# Web build (Vercel env var): VITE_VOICE_WS_URL=wss://your-api.up.railway.app

# Phase 6 alerts: optional Slack-compatible webhook. Payloads carry rule names and numbers only.
# ALERT_WEBHOOK_URL=

# Phase 6 analytics scripts (seed / report) default to an "svs_analytics" database next to DATABASE_URL.
# ANALYTICS_DATABASE_URL=
