{
  "name": "smart-voice-suggestions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Smart Voice Suggestions MVP: context-aware voice practice for Bharat Learners",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @svs/server\" \"npm run dev -w @svs/web\"",
    "dev:server": "npm run dev -w @svs/server",
    "dev:web": "npm run dev -w @svs/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "groq:check": "tsx scripts/groq-check.ts",
    "db:check": "tsx scripts/db-check.ts",
    "dataset:validate": "tsx scripts/dataset/validate.ts data/intent-eval/seed.jsonl",
    "dataset:agreement": "tsx scripts/dataset/agreement.ts",
    "db:local:init": "tsx scripts/local-db.ts init",
    "db:local:start": "tsx scripts/local-db.ts start",
    "db:local:stop": "tsx scripts/local-db.ts stop",
    "db:local:status": "tsx scripts/local-db.ts status",
    "db:migrate": "tsx apps/server/src/migrate-cli.ts",
    "dev:fake-groq": "tsx scripts/fake-groq.ts",
    "bench:ttft": "tsx scripts/bench-ttft.ts",
    "bench:decision": "tsx scripts/bench-decision.ts",
    "eval:classifier": "tsx scripts/eval/run-classifier.ts",
    "eval:check": "tsx scripts/eval/check.ts",
    "smoke:voice": "tsx scripts/voice-smoke.ts",
    "analytics:seed": "tsx scripts/analytics/seed.ts",
    "analytics:report": "tsx scripts/analytics/analyze.ts",
    "analytics:power": "tsx scripts/analytics/power.ts",
    "analytics:aa": "tsx scripts/analytics/aa.ts",
    "capacity:plan": "tsx scripts/capacity-plan.ts",
    "audit:a11y": "tsx scripts/a11y-audit.ts",
    "ops:config": "tsx scripts/ops-config.ts",
    "ops:cohort": "tsx scripts/ops-cohort.ts",
    "analytics:baseline": "tsx scripts/analytics/baseline.ts",
    "dogfood:export": "tsx scripts/dogfood/export-queries.ts",
    "dogfood:daily": "tsx scripts/dogfood/daily.ts",
    "dataset:label": "tsx scripts/dataset/label.ts",
    "gate:phase9": "tsx scripts/gate-phase9.ts",
    "ops:language": "tsx scripts/ops-language.ts",
    "ops:ramp": "tsx scripts/ops-ramp.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "demo": "tsx scripts/demo-run.ts",
    "demo:offline": "tsx scripts/demo-run.ts --offline"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.10.3",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
